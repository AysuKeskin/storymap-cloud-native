digraph storymap_gcp {
  graph [rankdir=TB, fontname="Helvetica", fontsize=20, splines=true, nodesep=0.3, ranksep=0.45, pad=0.3, newrank=true, compound=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=19, fillcolor="#ffffff", color="#5f6368", margin="0.15,0.06"];
  edge  [fontname="Helvetica", fontsize=16, color="#5f6368", arrowsize=0.9, penwidth=1.3];

  // ---------- clients ----------
  users  [label="End users\nWeb / Mobile", shape=ellipse, fillcolor="#e8eaed", ];

  subgraph cluster_gcp {
    label="GCP project - us-central1 - all resources provisioned with Terraform";
    style="rounded,dashed"; color="#1a73e8"; fontcolor="#1a73e8"; margin=14;

    lb [label="External HTTP(S) LB\nGKE Ingress + static IP", fillcolor="#e8f0fe"];

    subgraph cluster_gke {
      label="GKE Standard zonal cluster\nprivate nodes, node pool autoscaling 2-5 x e2-medium";
      style="rounded,filled"; fillcolor="#e6f4ea"; color="#188038"; fontcolor="#188038";
      frontend [label="frontend Deployment\nnginx + React build\nHPA 1-3"];
      api      [label="api Deployment\nDjango REST + Gunicorn\nHPA 2-10 @ 60% CPU", penwidth=2.2];
      redis    [label="redis Deployment\nshared cache + lock"];
      migrate  [label="migrate Job\nmanage.py migrate", style="rounded,dashed,filled"];
    }

    subgraph cluster_vms {
      label="Compute Engine VMs";
      style="rounded,filled"; fillcolor="#fef7e0"; color="#e37400"; fontcolor="#e37400";
      mysql  [label="mysql-vm (e2-medium)\nMySQL 8.0, private IP\nscheduled disk snapshots"];
      locust [label="locust-vm (e2-standard-4)\nLocust master + workers\nstarted only for tests"];
    }

    subgraph cluster_serverless {
      label="Event-driven / serverless";
      style="rounded,filled"; fillcolor="#fce8e6"; color="#c5221f"; fontcolor="#c5221f";
      gcs      [label="Cloud Storage bucket\nmedia + thumbnails", shape=cylinder, fillcolor="#ffffff"];
      fn_thumb [label="Cloud Function\nmake-thumbnail"];
      pubsub   [label="Pub/Sub topic\nemail-events"];
      fn_email [label="Cloud Function\nsend-email"];
    }

    subgraph cluster_ops {
      label="Platform services";
      style="rounded,filled"; fillcolor="#f1f3f4"; color="#9aa0a6"; fontcolor="#5f6368";
      ar  [label="Artifact Registry\ncontainer images"];
      nat [label="Cloud NAT\noutbound egress"];
      mon [label="Cloud Monitoring\n+ Logging"];
    }
  }

  nominatim [label="Nominatim API", shape=ellipse, fillcolor="#e8eaed", ];
  resend    [label="Resend email API", shape=ellipse, fillcolor="#e8eaed", ];

  // ---------- ranks (left -> right) ----------
  { rank=same; users; locust; }
  { rank=same; lb; migrate; }
  { rank=same; frontend; api; }
  { rank=same; redis; mysql; ar; }
  { rank=same; gcs; pubsub; nat; mon; }
  { rank=same; fn_thumb; fn_email; }
  { rank=same; nominatim; resend; }

  // ---------- flows ----------
  users  -> lb [label="HTTPS"];
  locust -> lb [label="load test", style=dashed, color="#e37400", fontcolor="#e37400"];
  lb -> frontend [label="/"];
  lb -> api [label="/api/*"];
  api -> redis [label="cache"];
  api -> mysql [label="SQL :3306"];
  migrate -> mysql [style=dashed];
  api -> gcs [label="upload"];
  api -> pubsub [label="publish event"];
  gcs -> fn_thumb [label="object finalize\n(writes thumbnail back)"];
  pubsub -> fn_email [label="trigger"];
  fn_email -> resend [label="HTTPS"];
  api -> nat [label="egress", style=dotted];
  nat -> nominatim [style=dotted];
  ar -> mon [style=invis];
  redis -> ar [style=invis];
}
